{
  // ============================================================
  // 本地开发专用模板。
  // `npm run dev:setup` 会把它复制为仓库根目录的 wrangler.jsonc；
  // 根目录的 wrangler.jsonc 已被 .gitignore 忽略，不会提交，
  // 所以生产环境不会采用它 —— 线上的 D1 / R2 绑定在 Pages 控制台配置（见 README）。
  // ============================================================
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chenhome2026",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-09-26",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chenhome-db",
      "database_id": "local-dev-only"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "chenhome-images"
    }
  ]
}
