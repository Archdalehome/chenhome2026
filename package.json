{
  "name": "casa-plume",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "preview": "npx --yes serve@14 out",
    "preview:cf": "wrangler pages dev --persist-to=.wrangler/state",
    "dev:setup": "node scripts/setup-local.mjs",
    "db:init": "wrangler d1 execute chenhome-db -c dev/wrangler.remote.jsonc --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute chenhome-db --local --persist-to=.wrangler/state --file=./schema.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:create:local": "node scripts/create-admin.mjs --local",
    "smoke:local": "powershell -NoProfile -ExecutionPolicy Bypass -File dev/smoke-test.ps1"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.141.0"
  }
}
