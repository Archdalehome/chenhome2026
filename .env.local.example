# 复制此文件为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会提交）
# Cloudflare Pages 请在 Settings -> Environment variables 中配置相同变量

# Supabase 项目 URL（Project Settings -> API -> Project URL）
NEXT_PUBLIC_SUPABASE_URL=你的supabase项目URL

# Supabase anon public key（Project Settings -> API -> anon public）
# 注意：anon key 本身是公开的，真正的安全边界由数据库 RLS 策略保证
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的supabase anon key

# 站点正式域名（用于 canonical / sitemap / Open Graph，结尾不要带斜杠）
NEXT_PUBLIC_SITE_URL=https://chenhome2026.pages.dev
